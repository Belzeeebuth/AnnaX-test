#!/usr/bin/env bash
# AnnaX Linux — CLI principal
# Usage : annax <commande> [args]

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'
BOLD='\033[1m'

VERSION="1.0.0"
AUR_HELPER=""

# ── Détection helper AUR ──────────────────────────────────────
detect_aur() {
    if command -v paru &>/dev/null; then
        AUR_HELPER="paru"
    elif command -v yay &>/dev/null; then
        AUR_HELPER="yay"
    else
        AUR_HELPER=""
    fi
}

# ── Helpers ───────────────────────────────────────────────────
msg()    { echo -e "${GREEN}▶${NC} ${BOLD}$*${NC}"; }
info()   { echo -e "${BLUE}ℹ${NC} $*"; }
warn()   { echo -e "${YELLOW}⚠${NC} $*"; }
err()    { echo -e "${RED}✗${NC} $*" >&2; }
ok()     { echo -e "${GREEN}✓${NC} $*"; }
section(){ echo -e "\n${MAGENTA}${BOLD}══ $* ══${NC}"; }

need_root() {
    [[ $EUID -eq 0 ]] || { err "Cette commande nécessite les droits root."; exit 1; }
}

confirm() {
    local prompt="${1:-Continuer ?}"
    echo -en "${YELLOW}?${NC} $prompt [o/N] "
    read -r ans
    [[ "$ans" =~ ^[oOyY]$ ]]
}

# ── Bannière ──────────────────────────────────────────────────
banner() {
    echo -e "${MAGENTA}${BOLD}"
    echo "   █████╗ ███╗   ██╗███╗   ██╗ █████╗ ██╗  ██╗"
    echo "  ██╔══██╗████╗  ██║████╗  ██║██╔══██╗╚██╗██╔╝"
    echo "  ███████║██╔██╗ ██║██╔██╗ ██║███████║ ╚███╔╝ "
    echo "  ██╔══██║██║╚██╗██║██║╚██╗██║██╔══██║ ██╔██╗ "
    echo "  ██║  ██║██║ ╚████║██║ ╚████║██║  ██║██╔╝ ██╗"
    echo "  ╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝"
    echo -e "${NC}  ${CYAN}AnnaX Linux v${VERSION}${NC} — Arch based"
    echo ""
}

# ── Aide ─────────────────────────────────────────────────────
show_help() {
    banner
    echo -e "${BOLD}Usage :${NC}  annax <commande> [options]"
    echo ""
    echo -e "${BOLD}Paquets :${NC}"
    echo -e "  ${GREEN}annax update${NC}                         Mettre à jour tous les paquets (pacman + AUR si paru installé)"
    echo -e "  ${GREEN}annax install${NC} <paquet...>             Installer un ou plusieurs paquets (pacman ou AUR auto-détecté)"
    echo -e "  ${GREEN}annax remove${NC}  <paquet...>             Désinstaller un paquet et ses dépendances orphelines"
    echo -e "  ${GREEN}annax search${NC}  <terme>                 Rechercher un paquet dans pacman et l'AUR"
    echo -e "  ${GREEN}annax info${NC}    <paquet>                Afficher les détails d'un paquet (version, dépendances...)"
    echo -e "  ${GREEN}annax list${NC}                           Lister tous les paquets installés explicitement"
    echo -e "  ${GREEN}annax orphans${NC}                        Lister les paquets orphelins (plus requis par rien)"
    echo -e "  ${GREEN}annax clean${NC}                          Nettoyer le cache pacman (libère de l'espace disque)"
    echo ""
    echo -e "${BOLD}Système :${NC}"
    echo -e "  ${GREEN}annax gpu${NC}     [status|amd|nvidia|hybrid]          Gérer le GPU (AMD intégré / NVIDIA dédié)"
    echo -e "  ${GREEN}annax power${NC}   [status|auto|performance|powersave]  Changer le profil d'énergie CPU"
    echo -e "  ${GREEN}annax mirrors${NC}                        Mettre à jour les miroirs pacman (plus rapide)"
    echo -e "  ${GREEN}annax services${NC}                       Voir le statut des services système AnnaX"
    echo -e "  ${GREEN}annax sysinfo${NC}                        Afficher les infos complètes du système"
    echo ""
    echo -e "${BOLD}Configuration :${NC}"
    echo -e "  ${GREEN}annax dotfiles${NC} [hyprland|kitty|waybar]  Réinstaller une config de bureau depuis les defaults"
    echo -e "  ${GREEN}annax theme${NC}   [mocha|latte|frappe|macchiato]      Changer le thème Catppuccin"
    echo ""
    echo -e "${BOLD}Installation & outils :${NC}"
    echo -e "  ${GREEN}annax setup${NC}                          Lancer l'installeur AnnaX (depuis le live ISO uniquement)"
    echo -e "  ${GREEN}annax setup gaming${NC}                   Installer les drivers NVIDIA (à faire après l'installation)"
    echo -e "  ${GREEN}annax aur${NC}                            Installer paru (helper AUR pour les paquets communautaires)"
    echo ""
    echo -e "${BOLD}Mise à jour AnnaX :${NC}"
    echo -e "  ${GREEN}annax self-update${NC}                    Mettre à jour les scripts annax depuis GitHub"
    echo -e "                                       → télécharge la dernière version de annax et annax-install"
    echo -e "                                       → utile après une mise à jour du projet AnnaX"
    echo ""
    echo -e "${BOLD}Autre :${NC}"
    echo -e "  ${GREEN}annax version${NC}                        Afficher la version actuelle de annax"
    echo -e "  ${GREEN}annax help${NC}                           Afficher cette aide"
    echo ""
}

# ══════════════════════════════════════════════════════════════
# PAQUETS
# ══════════════════════════════════════════════════════════════

cmd_update() {
    section "Mise à jour du système"
    detect_aur

    msg "Synchronisation et mise à jour des paquets..."
    if [[ -n "$AUR_HELPER" ]]; then
        info "Helper AUR détecté : $AUR_HELPER (inclus dans la mise à jour)"
        $AUR_HELPER -Syu --noconfirm
    else
        sudo pacman -Syu
    fi
    ok "Système à jour."
}

cmd_self_update() {
    local repo="https://raw.githubusercontent.com/Belzeeebuth/AnnaX-test/master"
    local tmp=$(mktemp)

    section "Mise à jour des scripts AnnaX"
    info "Téléchargement depuis GitHub..."

    # Mise à jour de annax
    if curl -fsSL "$repo/airootfs/usr/local/bin/annax" -o "$tmp"; then
        sudo install -m755 "$tmp" /usr/local/bin/annax
        ok "annax mis à jour."
    else
        err "Impossible de télécharger le script annax."
        rm -f "$tmp"; exit 1
    fi

    # Mise à jour de annax-install
    if curl -fsSL "$repo/airootfs/usr/local/bin/annax-install" -o "$tmp"; then
        sudo install -m755 "$tmp" /usr/local/bin/annax-install
        ok "annax-install mis à jour."
    else
        warn "Impossible de télécharger annax-install (non bloquant)."
    fi

    # Mise à jour de annax-welcome
    if curl -fsSL "$repo/airootfs/usr/local/bin/annax-welcome" -o "$tmp"; then
        sudo install -m755 "$tmp" /usr/local/bin/annax-welcome
        ok "annax-welcome mis à jour."
    else
        warn "Impossible de télécharger annax-welcome (non bloquant)."
    fi

    rm -f "$tmp"
    ok "Scripts AnnaX à jour. Relance annax pour voir les changements."
}

cmd_install() {
    [[ $# -eq 0 ]] && { err "Spécifie au moins un paquet.  Ex: annax install firefox"; exit 1; }
    section "Installation : $*"
    detect_aur

    if [[ -n "$AUR_HELPER" ]]; then
        $AUR_HELPER -S "$@"
    else
        sudo pacman -S "$@"
    fi
}

cmd_remove() {
    [[ $# -eq 0 ]] && { err "Spécifie au moins un paquet.  Ex: annax remove vlc"; exit 1; }
    section "Désinstallation : $*"
    confirm "Désinstaller $* et ses dépendances orphelines ?" || exit 0
    sudo pacman -Rns "$@"
    ok "Paquet(s) supprimé(s)."
}

cmd_search() {
    [[ $# -eq 0 ]] && { err "Spécifie un terme de recherche."; exit 1; }
    section "Recherche : $*"
    detect_aur

    if [[ -n "$AUR_HELPER" ]]; then
        $AUR_HELPER -Ss "$@"
    else
        pacman -Ss "$@"
    fi
}

cmd_info() {
    [[ $# -eq 0 ]] && { err "Spécifie un paquet."; exit 1; }
    detect_aur

    if pacman -Si "$1" &>/dev/null; then
        pacman -Si "$1"
    elif [[ -n "$AUR_HELPER" ]]; then
        $AUR_HELPER -Si "$1"
    else
        err "Paquet '$1' introuvable."
    fi
}

cmd_list() {
    section "Paquets installés explicitement"
    pacman -Qe | awk '{printf "  %-35s %s\n", $1, $2}' | less -R
}

cmd_orphans() {
    section "Paquets orphelins"
    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null) || true

    if [[ -z "$orphans" ]]; then
        ok "Aucun paquet orphelin."
    else
        echo "$orphans"
        echo ""
        if confirm "Supprimer tous les orphelins ?"; then
            # shellcheck disable=SC2086
            sudo pacman -Rns $orphans
            ok "Orphelins supprimés."
        fi
    fi
}

cmd_clean() {
    section "Nettoyage du cache"
    info "Cache actuel :"
    du -sh /var/cache/pacman/pkg/ 2>/dev/null || true

    confirm "Supprimer les paquets en cache non installés ?" || exit 0
    sudo pacman -Sc
    ok "Cache nettoyé."
}

# ══════════════════════════════════════════════════════════════
# SYSTÈME
# ══════════════════════════════════════════════════════════════

cmd_gpu() {
    local action="${1:-status}"
    section "Gestion GPU hybride AMD+NVIDIA"

    case "$action" in
        status)
            info "GPU actif :"
            if command -v envycontrol &>/dev/null; then
                envycontrol --query
            else
                glxinfo 2>/dev/null | grep "OpenGL renderer" || lspci | grep -i "vga\|3d\|display"
            fi
            echo ""
            info "Carte AMD  : $(lspci | grep -i amd | grep -i 'vga\|display' | head -1 | cut -d: -f3 | xargs)"
            info "Carte NVIDIA: $(lspci | grep -i nvidia | grep -i 'vga\|3d' | head -1 | cut -d: -f3 | xargs)"
            ;;
        hybrid)
            msg "Passage en mode Hybride (AMD par défaut, NVIDIA à la demande)..."
            if command -v envycontrol &>/dev/null; then
                sudo envycontrol --switch hybrid
            else
                warn "envycontrol non installé. Installe : annax install envycontrol"
                info "Mode manuel : utilise DRI_PRIME=1 <commande> pour le NVIDIA"
            fi
            warn "Redémarre pour appliquer : sudo reboot"
            ;;
        nvidia)
            msg "Passage en mode NVIDIA uniquement..."
            if command -v envycontrol &>/dev/null; then
                sudo envycontrol --switch nvidia
            else
                warn "envycontrol non installé. Installe : annax install envycontrol"
            fi
            warn "Redémarre pour appliquer : sudo reboot"
            ;;
        amd)
            msg "Passage en mode AMD uniquement (NVIDIA désactivé)..."
            if command -v envycontrol &>/dev/null; then
                sudo envycontrol --switch integrated
            else
                warn "envycontrol non installé. Installe : annax install envycontrol"
            fi
            warn "Redémarre pour appliquer : sudo reboot"
            ;;
        *)
            err "Mode inconnu : $action"
            info "Modes disponibles : status, hybrid, nvidia, amd"
            exit 1
            ;;
    esac
}

cmd_power() {
    local action="${1:-status}"
    section "Gestion énergie CPU"

    case "$action" in
        status)
            info "Mode auto-cpufreq :"
            if command -v auto-cpufreq &>/dev/null; then
                sudo auto-cpufreq --stats 2>/dev/null | head -20 || auto-cpufreq --get-state 2>/dev/null || true
            fi
            echo ""
            info "Gouverneur actuel : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'inconnu')"
            info "Fréquence actuelle : $(grep 'cpu MHz' /proc/cpuinfo | head -1 | awk '{printf "%.0f MHz\n", $4}')"
            ;;
        auto)
            msg "Mode automatique (auto-cpufreq)..."
            sudo systemctl enable --now auto-cpufreq
            ok "auto-cpufreq activé."
            ;;
        performance)
            msg "Mode performance..."
            echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null
            ok "Gouverneur : performance"
            ;;
        powersave)
            msg "Mode économie d'énergie..."
            echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null
            ok "Gouverneur : powersave"
            ;;
        *)
            err "Action inconnue : $action"
            info "Actions : status, auto, performance, powersave"
            exit 1
            ;;
    esac
}

cmd_mirrors() {
    section "Mise à jour des miroirs"
    msg "Sélection des miroirs les plus rapides (France, Belgique, Allemagne)..."
    sudo reflector \
        --country France,Belgium,Germany \
        --latest 10 \
        --sort rate \
        --save /etc/pacman.d/mirrorlist
    ok "Miroirs mis à jour."
    info "Contenu :"
    head -20 /etc/pacman.d/mirrorlist
}

cmd_services() {
    section "Services AnnaX"
    local services=(NetworkManager bluetooth auto-cpufreq tlp thermald acpid)

    printf "  %-25s %s\n" "SERVICE" "STATUT"
    printf "  %-25s %s\n" "─────────────────────────" "──────────"
    for svc in "${services[@]}"; do
        local status
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            status="${GREEN}actif${NC}"
        elif systemctl is-enabled --quiet "$svc" 2>/dev/null; then
            status="${YELLOW}inactif (activé)${NC}"
        else
            status="${RED}désactivé${NC}"
        fi
        printf "  %-25s " "$svc"
        echo -e "$status"
    done
    echo ""
}

cmd_sysinfo() {
    section "Informations système AnnaX"
    echo ""

    # OS
    info "OS          : $(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')"
    info "Kernel      : $(uname -r)"
    info "Arch        : $(uname -m)"

    # CPU
    info "CPU         : $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)"
    info "Cores       : $(nproc) logiques"
    info "Fréquence   : $(grep 'cpu MHz' /proc/cpuinfo | head -1 | awk '{printf "%.0f MHz", $4}')"
    info "Gouverneur  : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'N/A')"

    # RAM
    local total used
    total=$(free -h | awk '/^Mem:/{print $2}')
    used=$(free -h | awk '/^Mem:/{print $3}')
    info "RAM         : $used / $total"

    # GPU
    info "GPU AMD     : $(lspci | grep -i amd | grep -i 'vga\|display' | head -1 | cut -d: -f3 | xargs || echo 'N/A')"
    info "GPU NVIDIA  : $(lspci | grep -i nvidia | grep -i '3d\|vga' | head -1 | cut -d: -f3 | xargs || echo 'N/A')"

    # Stockage
    echo ""
    info "Stockage :"
    df -h --output=source,size,used,avail,pcent,target 2>/dev/null | grep -v 'tmpfs\|devtmpfs\|overlay' | \
        awk 'NR==1{printf "    %-20s %-8s %-8s %-8s %-6s %s\n",$1,$2,$3,$4,$5,$6; next} \
             {printf "    %-20s %-8s %-8s %-8s %-6s %s\n",$1,$2,$3,$4,$5,$6}'

    # Réseau
    echo ""
    info "Réseau :"
    ip -br addr show 2>/dev/null | grep -v '^lo' | awk '{printf "    %-12s %-12s %s\n", $1, $2, $3}'

    echo ""
    info "Uptime      : $(uptime -p 2>/dev/null | sed 's/^up //')"
    info "annax       : v${VERSION}"
    echo ""
}

# ══════════════════════════════════════════════════════════════
# CONFIGURATION
# ══════════════════════════════════════════════════════════════

cmd_dotfiles() {
    local target="${1:-}"
    local config_dir="$HOME/.config"
    local dotfiles_src="/usr/share/annax/dotfiles"

    section "Réinstallation des dotfiles"

    [[ -d "$dotfiles_src" ]] || dotfiles_src="/root/dotfiles"
    [[ -d "$dotfiles_src" ]] || { err "Source dotfiles introuvable : $dotfiles_src"; exit 1; }

    case "$target" in
        hyprland)
            [[ -d "$dotfiles_src/hyprland" ]] || { err "Dotfiles Hyprland non trouvés."; exit 1; }
            confirm "Écraser la config Hyprland actuelle dans ~/.config/ ?" || exit 0
            cp -r "$dotfiles_src/hyprland/." "$config_dir/"
            ok "Config Hyprland restaurée."
            ;;
        i3)
            [[ -d "$dotfiles_src/i3" ]] || { err "Dotfiles i3 non trouvés."; exit 1; }
            confirm "Écraser la config i3 actuelle dans ~/.config/ ?" || exit 0
            cp -r "$dotfiles_src/i3/." "$config_dir/"
            chmod +x "$config_dir/polybar/launch.sh" 2>/dev/null || true
            ok "Config i3 restaurée."
            ;;
        kitty)
            [[ -f "$dotfiles_src/hyprland/kitty/kitty.conf" ]] || { err "Config kitty non trouvée."; exit 1; }
            mkdir -p "$config_dir/kitty"
            cp "$dotfiles_src/hyprland/kitty/kitty.conf" "$config_dir/kitty/"
            ok "Config kitty restaurée."
            ;;
        waybar)
            [[ -d "$dotfiles_src/hyprland/waybar" ]] || { err "Config waybar non trouvée."; exit 1; }
            mkdir -p "$config_dir/waybar"
            cp -r "$dotfiles_src/hyprland/waybar/." "$config_dir/waybar/"
            ok "Config waybar restaurée. Lance : killall waybar && waybar &"
            ;;
        "")
            info "Targets disponibles : hyprland, i3, kitty, waybar"
            info "Ex: annax dotfiles hyprland"
            ;;
        *)
            err "Target inconnu : $target"
            info "Targets : hyprland, i3, kitty, waybar"
            exit 1
            ;;
    esac
}

cmd_theme() {
    local theme="${1:-mocha}"
    section "Thème Catppuccin : $theme"
    warn "Fonctionnalité en développement."
    info "Thèmes disponibles : mocha (défaut), latte, frappe, macchiato"
    info "Pour l'instant, édite manuellement les couleurs dans tes configs."
}

# ══════════════════════════════════════════════════════════════
# INSTALLATION / AUR
# ══════════════════════════════════════════════════════════════

cmd_setup() {
    local subcmd="${1:-}"
    case "$subcmd" in
        gaming) cmd_gaming ;;
        "")
            section "Installeur AnnaX Linux"
            if [[ -f /usr/local/bin/annax-install ]]; then
                exec annax-install
            else
                err "Installeur non disponible. Lance cette commande depuis le live ISO AnnaX."
                exit 1
            fi
            ;;
        *)
            err "Sous-commande inconnue : $subcmd"
            info "Disponible : annax setup gaming"
            exit 1
            ;;
    esac
}

cmd_gaming() {
    section "Installation drivers NVIDIA (Gaming)"

    info "Paquets qui vont être installés :"
    info "  nvidia-open-dkms, nvidia-utils, lib32-nvidia-utils"
    info "  nvidia-settings, nvidia-prime, egl-wayland"
    info "  libvdpau, lib32-libvdpau"
    echo ""

    echo -e "${YELLOW}?${NC} Mode GPU :"
    echo "  1) Hybrid  — AMD par défaut, NVIDIA à la demande avec DRI_PRIME=1 (Recommandé)"
    echo "  2) NVIDIA  — GPU NVIDIA forcé tout le temps"
    echo -en "${YELLOW}?${NC} Choix [1] : "
    read -r choice
    local mode="${choice:-1}"

    confirm "Installer les drivers NVIDIA maintenant ?" || exit 0

    msg "Vérification du dépôt multilib..."
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        msg "Activation de multilib..."
        sudo sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
    fi
    sudo pacman -Syy

    msg "Installation des drivers NVIDIA..."
    sudo pacman -S --noconfirm \
        nvidia-open-dkms nvidia-utils lib32-nvidia-utils \
        nvidia-settings nvidia-prime egl-wayland \
        libvdpau lib32-libvdpau

    if [[ "$mode" == "2" ]]; then
        msg "Configuration NVIDIA forcé..."
        sudo tee /etc/environment > /dev/null <<'EOF'
# NVIDIA forcé — AMD ignoré
__NV_PRIME_RENDER_OFFLOAD=1
__GLX_VENDOR_LIBRARY_NAME=nvidia
__VK_LAYER_NV_optimus=NVIDIA_only
EOF
        sudo tee /etc/modprobe.d/nvidia.conf > /dev/null <<'EOF'
options nvidia-drm modeset=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1
EOF
    else
        msg "Configuration mode Hybride AMD+NVIDIA..."
        sudo tee /etc/environment > /dev/null <<'EOF'
# Hybrid AMD+NVIDIA — pour forcer NVIDIA : DRI_PRIME=1 <commande>
AMD_VULKAN_ICD=RADV
EOF
    fi

    ok "Drivers NVIDIA installés !"
    echo ""
    warn "Redémarre pour appliquer : sudo reboot"
    echo ""
    info "Commandes utiles après redémarrage :"
    info "  DRI_PRIME=1 <app>        — Lancer une app sur NVIDIA"
    info "  annax gpu status         — Voir le GPU actif"
    info "  annax gpu hybrid|nvidia  — Changer de mode"
    echo ""
}

cmd_aur() {
    section "Installation de paru (helper AUR)"
    detect_aur

    if [[ -n "$AUR_HELPER" ]]; then
        ok "$AUR_HELPER est déjà installé."
        exit 0
    fi

    msg "Installation de paru depuis l'AUR..."
    local tmp
    tmp=$(mktemp -d)
    cd "$tmp"

    if command -v git &>/dev/null; then
        git clone https://aur.archlinux.org/paru.git .
        makepkg -si --noconfirm
        ok "paru installé. Tu peux maintenant utiliser annax install pour les paquets AUR."
    else
        err "git non installé. Lance d'abord : annax install git"
    fi

    cd - > /dev/null
    rm -rf "$tmp"
}

# ══════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        # Paquets
        update)         cmd_update "$@" ;;
        install|i)      cmd_install "$@" ;;
        remove|rm|r)    cmd_remove "$@" ;;
        search|s)       cmd_search "$@" ;;
        info)           cmd_info "$@" ;;
        list|ls)        cmd_list "$@" ;;
        orphans)        cmd_orphans "$@" ;;
        clean)          cmd_clean "$@" ;;

        # Système
        gpu)            cmd_gpu "$@" ;;
        power)          cmd_power "$@" ;;
        mirrors)        cmd_mirrors "$@" ;;
        services)       cmd_services "$@" ;;
        sysinfo|info-sys) cmd_sysinfo "$@" ;;

        # Config
        dotfiles|dots)  cmd_dotfiles "$@" ;;
        theme)          cmd_theme "$@" ;;

        # Install / AUR
        setup)          cmd_setup "$@" ;;
        aur)            cmd_aur "$@" ;;

        # Meta
        self-update|selfupdate)
                        cmd_self_update ;;
        version|-v|--version)
            echo "annax v${VERSION} — AnnaX Linux"
            ;;
        help|-h|--help) show_help ;;

        *)
            err "Commande inconnue : $cmd"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
