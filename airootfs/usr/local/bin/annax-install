#!/usr/bin/env bash
# AnnaX Linux — Installeur Interactif

set -euo pipefail

# ── Couleurs & constantes ─────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

TITLE="AnnaX Linux Installer"
LOG="/tmp/annax-install.log"
MOUNT="/mnt"

# Variables globales
DISK=""
BOOT_PART=""
ROOT_PART=""
SWAP_PART=""
HOSTNAME=""
USERNAME=""
USERPASS=""
ROOTPASS=""
LOCALE="fr_FR.UTF-8"
TIMEZONE="Europe/Paris"
KEYMAP="fr"
DE=""
FS_TYPE="btrfs"
SWAP_SIZE=8
USE_SWAP=true
BOOT_SIZE=512

# ── Helpers UI ────────────────────────────────────────────────
msg()  { echo -e "${GREEN}▶${NC} $*"; }
info() { echo -e "${BLUE}ℹ${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }
err()  { echo -e "${RED}✗${NC} $*" >&2; }
ok()   { echo -e "${GREEN}✓${NC} $*"; }

die() { err "$1"; exit 1; }

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

dlg() { dialog --backtitle "AnnaX Linux Installer" "$@" 2>&1 >/dev/tty; }

check_root() {
    [[ $EUID -eq 0 ]] || die "Lance l'installeur en root : sudo annax setup"
}

check_internet() {
    msg "Vérification connexion internet..."
    ping -c1 -W3 archlinux.org &>/dev/null || die "Pas de connexion internet. Configure le réseau d'abord (nmtui)."
    ok "Internet OK"
}

