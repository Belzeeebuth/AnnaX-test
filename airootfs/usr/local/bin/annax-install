# ── Sélection du disque ───────────────────────────────────────
select_disk() {
    local disks=()
    while IFS= read -r line; do
        local dev size model
        dev=$(echo "$line" | awk '{print $1}')
        size=$(echo "$line" | awk '{print $2}')
        model=$(echo "$line" | awk '{$1=$2=""; print $0}' | xargs)
        disks+=("/dev/$dev" "$size - $model")
    done < <(lsblk -dno NAME,SIZE,MODEL | grep -v "^loop\|^sr")

    DISK=$(dlg --title "Sélection du disque" \
        --menu "\nChoisis le disque d'installation :\n" 15 60 6 \
        "${disks[@]}") || die "Aucun disque sélectionné."

    # Confirmation
    local disk_info
    disk_info=$(lsblk "$DISK" -o NAME,SIZE,TYPE,MOUNTPOINT 2>/dev/null)
    dialog --backtitle "$TITLE" \
        --title "Confirmation" \
        --yesno "\n⚠ TOUT sera effacé sur : $DISK\n\n$disk_info\n\nConfirmer ?" 15 60
    [[ $? -eq 0 ]] || select_disk
}

# ── Système de fichiers ───────────────────────────────────────
select_filesystem() {
    FS_TYPE=$(dlg --title "Système de fichiers" \
        --menu "\nChoisis le système de fichiers pour / :" 12 50 3 \
        "btrfs"  "BTRFS avec snapshots (Recommandé)" \
        "ext4"   "EXT4 — classique et stable" \
        "xfs"    "XFS — bonnes perfs sur gros fichiers") || FS_TYPE="btrfs"
}

# ── Swap ─────────────────────────────────────────────────────
configure_swap() {
    dialog --backtitle "$TITLE" \
        --title "Partition Swap" \
        --yesno "\nCréer une partition swap ?\n(Recommandé si tu veux hiberner)" 8 50

    if [[ $? -eq 0 ]]; then
        USE_SWAP=true
        SWAP_SIZE=$(dlg --title "Taille du Swap" \
            --menu "\nTaille du swap :" 12 40 5 \
            "4"  "4 Go" \
            "8"  "8 Go (Recommandé)" \
            "16" "16 Go" \
            "32" "32 Go") || SWAP_SIZE=8
    else
        USE_SWAP=false
    fi
}

# ── Locale & clavier ─────────────────────────────────────────
configure_locale() {
    LOCALE=$(dlg --title "Langue du système" \
        --menu "\nChoisis ta locale :" 15 50 6 \
        "fr_FR.UTF-8" "Français (France)" \
        "en_US.UTF-8" "English (US)" \
        "en_GB.UTF-8" "English (UK)" \
        "de_DE.UTF-8" "Deutsch" \
        "es_ES.UTF-8" "Español" \
        "it_IT.UTF-8" "Italiano") || LOCALE="fr_FR.UTF-8"

    KEYMAP=$(dlg --title "Disposition clavier" \
        --menu "\nChoisis ton clavier :" 12 40 5 \
        "fr"      "AZERTY Français" \
        "fr-latin9" "AZERTY Français (Latin 9)" \
        "us"      "QWERTY US" \
        "uk"      "QWERTY UK" \
        "de"      "QWERTZ Allemand") || KEYMAP="fr"
}

# ── Timezone ──────────────────────────────────────────────────
configure_timezone() {
    local region
    region=$(dlg --title "Région" \
        --menu "\nChoisis ta région :" 15 50 8 \
        "Europe"   "Europe" \
        "America"  "Amérique" \
        "Asia"     "Asie" \
        "Africa"   "Afrique" \
        "Australia" "Australie" \
        "Pacific"  "Pacifique") || region="Europe"

    local cities=()
    while IFS= read -r tz; do
        cities+=("$tz" "")
    done < <(timedatectl list-timezones | grep "^$region/" | sed "s|^$region/||")

    local city
    city=$(dlg --title "Ville" \
        --menu "\nChoisis ta ville :" 20 50 12 \
        "${cities[@]}") || city="Paris"

    TIMEZONE="$region/$city"
}

# ── Hostname ──────────────────────────────────────────────────
configure_hostname() {
    while true; do
        HOSTNAME=$(dlg --title "Nom de la machine" \
            --inputbox "\nEntre le hostname de ta machine :" 8 50 "annaxpc") || die "Annulé"
        [[ -n "$HOSTNAME" && "$HOSTNAME" =~ ^[a-zA-Z0-9-]+$ ]] && break
        dialog --msgbox "Hostname invalide. Utilise uniquement lettres, chiffres et tirets." 6 50
    done
}

# ── Utilisateur ───────────────────────────────────────────────
configure_user() {
    while true; do
        USERNAME=$(dlg --title "Nom d'utilisateur" \
            --inputbox "\nEntre ton nom d'utilisateur :" 8 50 "") || die "Annulé"
        [[ -n "$USERNAME" && "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] && break
        dialog --msgbox "Nom invalide. Utilise uniquement des minuscules, chiffres et underscores." 6 50
    done

    while true; do
        USERPASS=$(dlg --title "Mot de passe utilisateur" \
            --passwordbox "\nMot de passe pour $USERNAME :" 8 50) || die "Annulé"
        local confirm
        confirm=$(dlg --title "Confirmation" \
            --passwordbox "\nConfirme le mot de passe :" 8 50) || die "Annulé"
        [[ "$USERPASS" == "$confirm" && -n "$USERPASS" ]] && break
        dialog --msgbox "Les mots de passe ne correspondent pas ou sont vides." 6 50
    done

    while true; do
        ROOTPASS=$(dlg --title "Mot de passe root" \
            --passwordbox "\nMot de passe root :" 8 50) || die "Annulé"
        local confirm
        confirm=$(dlg --title "Confirmation root" \
            --passwordbox "\nConfirme le mot de passe root :" 8 50) || die "Annulé"
        [[ "$ROOTPASS" == "$confirm" && -n "$ROOTPASS" ]] && break
        dialog --msgbox "Les mots de passe ne correspondent pas ou sont vides." 6 50
    done
}

